{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Run FillSync (Backend + Frontend)",
      "type": "shell",
      "command": "node fillsync/start-project.js",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ Start Frontend Only (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/fillsync/users/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "🛡️ Start Backend Only (Port 5000)",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/fillsync/users/backend"
      },
      "problemMatcher": []
    }
  ]
}
