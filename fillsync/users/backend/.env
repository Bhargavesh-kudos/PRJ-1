# ============================================================================
# FILLSYNC CONFIGURATION (.env)
# ============================================================================

PORT=5000

# --- SUPERADMIN CREDENTIALS ---
SUPERADMIN_NAME=SuperAdmin
SUPERADMIN_EMAIL=admin@fillsync.com
SUPERADMIN_PASSWORD=Admin@123

# --- SECURITY & ENCRYPTION KEYS ---
JWT_SECRET=fillsync_super_secret_jwt_key_2026_prj1
ENCRYPTION_KEY=fillsync_32_byte_aes_secret_key!

# --- OPTIONAL GEMINI AI KEY ---
GEMINI_API_KEY=

# --- RAZORPAY PAYMENT GATEWAY SETTLEMENT (FOR DEPLOYMENT) ---
# How money reaches your bank account when deployed:
# 1. Sign up on https://dashboard.razorpay.com (Link your Bank Account & IFSC)
# 2. Go to Account & Settings -> API Keys -> Generate Key
# 3. Paste your Key ID and Key Secret below.
# Whenever any user pays ₹99 for Premium, Razorpay automatically deposits
# the money directly into your linked Indian Bank Account (T+1 settlement)!
# Leave blank or as-is for local development demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
