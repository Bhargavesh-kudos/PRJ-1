{
  "manifest_version": 3,
  "name": "FillSync — Smart Form Automation",
  "version": "1.0.0",
  "description": "1-Click Human-Like Form Automation & Smart Template Injector synced with FillSync Localhost Dashboard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:5000/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FillSync Form Automation"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/domInjector.js"]
    }
  ]
}
